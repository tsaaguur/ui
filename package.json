{
  "name": "@tsaaguur/ui",
  "version": "0.3.1",
  "private": true,
  "description": "Tsaaguur's own UI library: tokens, type, drawn icons, topic pictograms, marks that move, panels, pills, the story board. Documented at ui.tsaaguur.mn.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "site:dev": "pnpm --filter ./site dev",
    "site:build": "pnpm --filter ./site build",
    "site:typecheck": "pnpm --filter ./site typecheck"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tsaaguur/ui.git"
  },
  "homepage": "https://ui.tsaaguur.mn",
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "typescript",
    "ui-library",
    "design-system",
    "components",
    "svg-icons",
    "icons",
    "pictograms",
    "animation",
    "mongolia",
    "mongolian",
    "tsaaguur"
  ]
}
